<% layout("/layouts/boilerplate") %>

<body>
    <div class="row">
        <div class="col-8 offset-2">
            <br>
            <h3>Create a New Listing</h3>

            <!-- Displaying Flash Error Messages -->
            <% if (locals.error) { %>
                <div class="alert alert-danger">
                    <%= locals.error %>
                </div>
            <% } %>

            <!-- Create Listing Form -->
            <form method="POST" action="/listings" enctype="multipart/form-data" class="needs-validation">
                <!-- Title Input -->
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input name="listing[title]" placeholder="Add a catchy title" type="text" class="form-control" required />
                    <div class="valid-feedback">Title looks good!</div>
                    <div class="invalid-feedback">Please enter a title.</div>
                </div>

                <!-- Description Input -->
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea name="listing[description]" placeholder="Enter description" class="form-control" required></textarea>
                    <div class="valid-feedback">Description looks good!</div>
                    <div class="invalid-feedback">Please enter a short description.</div>
                </div>

                <!-- Image Upload Input -->
                <div class="mb-3">
                    <label for="image" class="form-label">Upload Listing Image</label>
                    <input name="image" type="file" class="form-control" required />
                    <div class="invalid-feedback">Please upload an image.</div>
                </div>

                <!-- Price Input -->
                <div class="mb-3">
                    <label for="price" class="form-label">Price</label>
                    <input name="listing[price]" placeholder="1200" type="number" class="form-control" min="1" required />
                    <div class="valid-feedback">Price looks good!</div>
                    <div class="invalid-feedback">Please enter a valid price.</div>
                </div>

                <!-- Location Input -->
                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input name="listing[location]" placeholder="Bilaspur" type="text" class="form-control" required />
                    <div class="valid-feedback">Location looks good!</div>
                    <div class="invalid-feedback">Please enter a valid location.</div>
                </div>

                <!-- Country Dropdown -->
                <div class="mb-3">
                    <label for="country" class="form-label">Country</label>
                    <select name="listing[country]" class="form-control" required>
                        <option value="">Select a country</option>
                        <option value="India">India</option>
                        <option value="USA">USA</option>
                        <option value="Canada">Canada</option>
                        <!-- Add more countries if needed -->
                    </select>
                    <div class="invalid-feedback">Please select a valid country.</div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn btn-dark add-btn">Add Listing</button>
            </form>
            <br>
        </div>
    </div>
</body>



